    benchmark:
        "lrna/benchmarks/sortIndexTelescopeBam/{sample}.tsv"
    threads: 10
    conda:
        "omics"
    resources:
        mem_mb = 128000,
        runtime = 600
    shell:
        """
samtools sort -@8 -m4g {input.bam} > {output.sortedbam}
samtools index -@6 {output.sortedbam}
        """

