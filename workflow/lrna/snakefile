rule skera_split:
    input:
        bam = "{path}.bam"
    params:
        kinnexprimers = config["lrna"]["kinnex_primers"]
    output:
        segbam = "{path}.skerasplit.bam"    
    resources:
        cpus_per_task =46,
        runtime = 900,
        mem_mb = 120000
    container: None
    conda:
        "pacbio"
    shell:
        """
skera split {input.bam} {params.kinnexprimers} {output.segbam}
        """



# lima produces all barcoded BAMs in one run, so we use a sentinel file
# to ensure only one lima job per unique input BAM
rule lima:
    input:
        bam = "{path_to_raw_data}/{ubam_base_name}.bam"
    params:
        isoseq = config["lrna"]["isoseq_primers"]
    output:
        done = "{path_to_raw_data}/{ubam_base_name}.lima_done"
    resources:
        cpus_per_task =46,
        runtime = 900,
        mem_mb = 120000
    container: None
    conda:
        "pacbio"
    shell:
        """
lima {input.bam} {params.isoseq} {input.bam} --isoseq --peek-guess --overwrite-biosample-names --split-named
touch {output.done}
        """


rule isoseq_refine:
    input:
        lima_done = lambda w: "%s/%s.lima_done" % (
            sample_table.loc[sample_table.sample_name == w.sample, "path_to_raw_data"].iloc[0],
            sample_table.loc[sample_table.sample_name == w.sample, "ubam_base_name"].iloc[0]
        )
    params:
        bam = lambda w: "%s/%s.IsoSeqX_%s_5p--IsoSeqX_3p.bam" % (
            sample_table.loc[sample_table.sample_name == w.sample, "path_to_raw_data"].iloc[0],
            sample_table.loc[sample_table.sample_name == w.sample, "ubam_base_name"].iloc[0],
            sample_table.loc[sample_table.sample_name == w.sample, "barcode"].iloc[0]
        ),
        isoseq = config["lrna"]["isoseq_primers"]
    output:
        bam = "lrna/intermediates/{sample}/alignments/{sample}.unaligned.bam"
    resources:
        cpus_per_task =46,
        runtime = 900,
        mem_mb = 120000
    container: None
    conda:
        "isoseq"
    shell:
        """
isoseq refine {params.bam} {params.isoseq} {output.bam}
        """

rule pacbio_bam_to_fastq:
    input:
        bam = "lrna/intermediates/{sample}/alignments/{sample}.unaligned.bam"
    output:
        fastq = "lrna/intermediates/{sample}/fastqs/pacbio/{sample}.fq.gz"
    benchmark:
        "lrna/benchmarks/pacbio_bam_to_fastq/{sample}.tsv"
    conda: 
        "omics"
    resources:
        cpus_per_task =12
    shell:
        """
mkdir -p $(dirname {output.fastq})
samtools fastq {input.bam} > {input.bam}.fq
gzip {input.bam}.fq
mv {input.bam}.fq.gz {output.fastq}
        """



rule mycoplasmaCheckPacbio:
    input:
        fq = "lrna/intermediates/{sample}/fastqs/pacbio/{sample}.fq.gz"
    params:
        reference = config["lrna"]["mycoplasma"]
    output:
        bam = "lrna/qc/mycoplasma/pacbio/mycoplasma{sample}.bam"
    benchmark:
        "lrna/benchmarks/mycoplasmaCheckpacbio/{sample}.tsv"
    resources:
        cpus_per_task =20,
        runtime = 900,
        mem_mb = 80000
    conda:
        "minimap2"
    container: None
    shell:
        """
minimap2 -ax map-hifi -uf -t 12 {params.reference} {input.fq} | \
samtools sort -@4 -T {wildcards.sample} -O bam -o {output.bam}
samtools index -@8 {output.bam}
samtools stats {output.bam} > {output.bam}.stats.txt        
        """

rule minimap2pacbio:
    input:
        fq = "lrna/intermediates/{sample}/fastqs/pacbio/{sample}.fq.gz",
        aref = "aref.done.outfile"
    params:
        junctionbed = config["lrna"]["junctionbed"],
        reference = lambda wildcards: (
            "aref/default/%s.fa" % wildcards.sample
            if config["lrna"]["per_sample_ref"] == "yes"
            else "aref/default/A.REF.fa"
        )
    output:
        bam = "lrna/intermediates/{sample}/alignments/{rate}/{sample}.{type}.{modification_string}.bam"
    wildcard_constraints:
        sample="[IK]_[0-9A-Za-z_]+",
        type="[0-9A-Za-z]+",
        rate="pacbio",
        modification_string="[0-9A-Za-z_-]+"
    resources:
        cpus_per_task = 46,
        runtime = 900,
        mem_mb = 120000
    container: None
    conda:
        "minimap2"
    shell:
        """
mkdir -p $(dirname {output.bam})
minimap2 -ax splice:hq -uf -t 40 --junc-bed {params.junctionbed} {params.reference} {input.fq} | \
samtools view -bh -o {output.bam}
        """

rule fc_relaxed:
    input:
        sortedbam = lambda w: "lrna/intermediates/%s/alignments/%s/%s.%s.%s.sorted.bam" % (
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "rate"].iloc[0],
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "type"].iloc[0],
            sample_table.loc[sample_table.sample_name == w.sample, "modification_string"].iloc[0]
        ),
        libtype = "lrna/qc/library_type.txt"
    output:
        countsmessy = "lrna/intermediates/{sample}/counts/relaxed/{sample}rtesandgenes.counts_messy.txt",
        counts = "lrna/intermediates/{sample}/counts/relaxed/{sample}rtesandgenes.counts.txt",
    benchmark:
        "lrna/benchmarks/fc_relaxed/{sample}.tsv"
    params: 
        featureCountsstrandparam = getFeatureCountsStrandParam(),
        annotation_genesandrtes = lambda wildcards: "aref/default/%s_annotations/%s_repeatmasker_refseq.complete.gtf"%(wildcards.sample, wildcards.sample) if config["lrna"]["per_sample_ref"] == "yes" else "aref/default/A.REF_annotations/A.REF_repeatmasker_refseq.complete.gtf"
    conda:
        "omics"
    resources:
        cpus_per_task =4,
        runtime = 3000,
        mem_mb = 100000,
    shell: 
        """
echo {params.featureCountsstrandparam}
mkdir -p $(dirname {output.counts})
featureCounts -s {params.featureCountsstrandparam} -L -O -M --primary --ignoreDup --largestOverlap -R CORE -a {params.annotation_genesandrtes} -o {output.countsmessy} {input.sortedbam}
cut -f1,7- {output.countsmessy} | awk 'NR > 1' > {output.counts}
        """

