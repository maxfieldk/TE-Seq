rule geneBody_coverage:
    input:
        sortedbams = [
            "lrna/intermediates/%s/alignments/%s/%s.%s.%s.sorted.bam" % (
                s,
                sample_table.loc[sample_table.sample_name == s, "rate"].iloc[0],
                s,
                sample_table.loc[sample_table.sample_name == s, "type"].iloc[0],
                sample_table.loc[sample_table.sample_name == s, "modification_string"].iloc[0]
            )
            for s in samples
        ],
        sortedbambais = [
            "lrna/intermediates/%s/alignments/%s/%s.%s.%s.sorted.bam.bai" % (
                s,
                sample_table.loc[sample_table.sample_name == s, "rate"].iloc[0],
                s,
                sample_table.loc[sample_table.sample_name == s, "type"].iloc[0],
                sample_table.loc[sample_table.sample_name == s, "modification_string"].iloc[0]
            )
            for s in samples
        ]
    params:
        genemodel_bed = "/users/mkelsey/data/Nanopore/alz/gencodeV35hs1.bed"
    output:
        outfile = "lrna/qc/geneBody_coverage/geneBody_coverage.txt"
    benchmark:
        "lrna/benchmarks/geneBody_coverage/geneBody_coverage.tsv"
    resources:
        cpus_per_task =4,
        mem_mb = 50000
    conda:
        "rseqc"
