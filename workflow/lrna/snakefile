    script: 
        "scripts/analyzeNanosim.R"


#modification analysis

# Modification code mapping for splitting pileup/extract outputs
# Dorado model: m5C_2OmeC-inosine_m6A_2OmeA-pseU_2OmeU
MOD_CODE_TO_NAME = {
    "a": "m6A",
    "m": "m5C",
    "17596": "Am",
    "17802": "pseU",
    "19227": "Um",
    "19228": "Cm",
    "69426": "inosine"
}
MOD_NAMES = list(MOD_CODE_TO_NAME.values())

rule modbamtobed:
    input:
        sortedbam = lambda w: "lrna/intermediates/%s/alignments/%s/%s.%s.%s.sorted.bam" % (
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "rate"].iloc[0],
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "type"].iloc[0],
            sample_table.loc[sample_table.sample_name == w.sample, "modification_string"].iloc[0]
        ),
        sortedbamindex = lambda w: "lrna/intermediates/%s/alignments/%s/%s.%s.%s.sorted.bam.bai" % (
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "rate"].iloc[0],
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "type"].iloc[0],
            sample_table.loc[sample_table.sample_name == w.sample, "modification_string"].iloc[0]
        ),
    params:
        ref = lambda wildcards: "aref/default/%s.fa"%(wildcards.sample) if config["aref"]["update_ref_with_tldr"]["per_sample"] == "yes" else "aref/default/A.REF.fa"
    resources:
        cpus_per_task = 36,
        mem_mb = 200000,
        runtime = 800
    output:
        bed = "lrna/intermediates/{sample}/methylation/{sample}_bedMethyl.bed",
    container: None
    conda:
        "modkit"
    shell:
        """
mkdir -p $(dirname {output})
/oscar/data/jsedivy/mkelsey/tools/modkit pileup {input.sortedbam} {output.bed} \
--ref {params.ref} \
--interval-size 30000 \
--edge-filter 10 \
-t {resources.cpus_per_task}
        """

rule modbamtobed_region:
    input:
        sortedbam = lambda w: "lrna/intermediates/%s/alignments/%s/%s.%s.%s.sorted.bam" % (
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "rate"].iloc[0],
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "type"].iloc[0],
            sample_table.loc[sample_table.sample_name == w.sample, "modification_string"].iloc[0]
        ),
        sortedbamindex = lambda w: "lrna/intermediates/%s/alignments/%s/%s.%s.%s.sorted.bam.bai" % (
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "rate"].iloc[0],
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "type"].iloc[0],
            sample_table.loc[sample_table.sample_name == w.sample, "modification_string"].iloc[0]
        ),
    params:
        ref = lambda wildcards: "aref/default/%s.fa"%(wildcards.sample) if config["aref"]["update_ref_with_tldr"]["per_sample"] == "yes" else "aref/default/A.REF.fa",
        rte_beds_dir = lambda wildcards: "aref/default/%s_annotations/%s_rte_beds"%(wildcards.sample, wildcards.sample) if config["aref"]["update_ref_with_tldr"]["per_sample"] == "yes" else "aref/default/A.REF_annotations/A.REF_rte_beds"
    resources:
        cpus_per_task = 36,
        mem_mb = 300000,
        runtime = 800
    output:
        bed = "lrna/intermediates/{sample}/methylation/{sample}_{element}_bedMethyl.bed",
    container: None
    conda:
        "modkit"
    shell:
        """
mkdir -p $(dirname {output})
bedpath={params.rte_beds_dir}/{wildcards.element}.bed
/oscar/data/jsedivy/mkelsey/tools/modkit pileup {input.sortedbam} {output.bed} \
--ref {params.ref} \
--interval-size 30000 \
--include-bed $bedpath \
--edge-filter 10 \
-t {resources.cpus_per_task}
        """

rule split_bedmethyl_region_by_mod:
    input:
        bed = "lrna/intermediates/{sample}/methylation/{sample}_{element}_bedMethyl.bed"
    output:
        beds = expand("lrna/intermediates/{{sample}}/methylation/bymod/{{sample}}_{{element}}_{mod_name}_bedMethyl.bed", mod_name=MOD_NAMES)
    resources:
        cpus_per_task = 2,
        mem_mb = 16000,
        runtime = 120
    run:
        import os
        outdir = os.path.dirname(output.beds[0])
        shell("""
mkdir -p {outdir}
awk -F'\\t' -v outdir="{outdir}" -v sample="{wildcards.sample}" -v element="{wildcards.element}" '
BEGIN {{
    map["a"] = "m6A"
    map["m"] = "m5C"
    map["17596"] = "Am"
    map["17802"] = "pseU"
    map["19227"] = "Um"
    map["19228"] = "Cm"
    map["69426"] = "inosine"
}}
$4 in map {{
    outfile = outdir "/" sample "_" element "_" map[$4] "_bedMethyl.bed"
    print >> outfile
}}
' {input.bed}
# touch any output files that may be empty (mod not present in data)
for f in {output.beds}; do touch "$f"; done
        """)

rule call_split_bedmethyl_region:
    input:
        expand("lrna/intermediates/{sample}/methylation/bymod/{sample}_{element}_{mod_name}_bedMethyl.bed",
            sample=samples,
            element=config["lrna"]["rte_subfamily_read_level_analysis"],
            mod_name=MOD_NAMES)

rule extractmods:
    input:
        sortedbam = lambda w: "lrna/intermediates/%s/alignments/%s/%s.%s.%s.sorted.bam" % (
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "rate"].iloc[0],
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "type"].iloc[0],
            sample_table.loc[sample_table.sample_name == w.sample, "modification_string"].iloc[0]
        ),
        sortedbamindex = lambda w: "lrna/intermediates/%s/alignments/%s/%s.%s.%s.sorted.bam.bai" % (
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "rate"].iloc[0],
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "type"].iloc[0],
            sample_table.loc[sample_table.sample_name == w.sample, "modification_string"].iloc[0]
        ),
    output:
        read_mods = 'lrna/intermediates/{sample}/methylation/{sample}_readmods_NoContext_{region}.tsv'
    params:
        ref = config["lrna"]["reference"],
        rte_beds_dir = lambda wildcards: "aref/default/%s_annotations/%s_rte_beds"%(wildcards.sample, wildcards.sample) if config["aref"]["update_ref_with_tldr"]["per_sample"] == "yes" else "aref/default/A.REF_annotations/A.REF_rte_beds"
    resources:
        cpus_per_task = 8,
        mem_mb = 128000,
        runtime = 800
    container: None
    conda:
        "modkit"
    shell:
        """
mkdir -p $(dirname {output})
awk -F '\t' -v OFS='\t' '{{print $1, $2, $3, $4, $5, "."}}' {params.rte_beds_dir}/{wildcards.region}.bed > {output.read_mods}.temp_rtebed.bed

# subset BAM to only reads overlapping target regions to avoid OOM
samtools view -b -F 2304 -L {output.read_mods}.temp_rtebed.bed {input.sortedbam} > {output.read_mods}.temp_subset.bam
samtools index {output.read_mods}.temp_subset.bam

/oscar/data/jsedivy/mkelsey/tools/modkit extract \
--mapped \
--no-filtering \
--edge-filter 10 \
--include-bed {output.read_mods}.temp_rtebed.bed \
--ref {params.ref} \
--threads {resources.cpus_per_task} \
{output.read_mods}.temp_subset.bam \
{output.read_mods}

rm {output.read_mods}.temp_rtebed.bed {output.read_mods}.temp_subset.bam {output.read_mods}.temp_subset.bam.bai
        """

rule call_extractmods:
    input:
        read_mods = expand('lrna/intermediates/{sample}/methylation/{sample}_readmods_NoContext_{region}.tsv', sample = samples, region = config["lrna"]["rte_subfamily_read_level_analysis"])

rule split_bedmethyl_by_mod:
    input:
        bed = "lrna/intermediates/{sample}/methylation/{sample}_bedMethyl.bed"
    output:
        beds = expand("lrna/intermediates/{{sample}}/methylation/bymod/{{sample}}_{mod_name}_bedMethyl.bed", mod_name=MOD_NAMES)
    resources:
        cpus_per_task = 2,
        mem_mb = 16000,
        runtime = 120
    run:
        import os
        outdir = os.path.dirname(output.beds[0])
        shell("""
mkdir -p {outdir}
awk -F'\\t' -v outdir="{outdir}" -v sample="{wildcards.sample}" '
BEGIN {{
    map["a"] = "m6A"
    map["m"] = "m5C"
    map["17596"] = "Am"
    map["17802"] = "pseU"
    map["19227"] = "Um"
    map["19228"] = "Cm"
    map["69426"] = "inosine"
}}
$4 in map {{
    outfile = outdir "/" sample "_" map[$4] "_bedMethyl.bed"
    print >> outfile
}}
' {input.bed}
# touch any output files that may be empty (mod not present in data)
for f in {output.beds}; do touch "$f"; done
        """)

rule split_extractmods_by_mod:
    input:
        tsv = 'lrna/intermediates/{sample}/methylation/{sample}_readmods_NoContext_{region}.tsv'
    output:
        tsvs = expand('lrna/intermediates/{{sample}}/methylation/bymod/{{sample}}_readmods_NoContext_{{region}}_{mod_name}.tsv', mod_name=MOD_NAMES)
    resources:
        cpus_per_task = 2,
        mem_mb = 16000,
        runtime = 120
    run:
        import os
        outdir = os.path.dirname(output.tsvs[0])
        shell("""
mkdir -p {outdir}
# Extract header
header=$(head -1 {input.tsv})

# Write header to all output files
for mod_name in m6A m5C Am pseU Um Cm inosine; do
    outfile="{outdir}/{wildcards.sample}_readmods_NoContext_{wildcards.region}_${{mod_name}}.tsv"
    echo "$header" > "$outfile"
done

# Split by mod_code column (column 12)
awk -F'\\t' -v outdir="{outdir}" -v sample="{wildcards.sample}" -v region="{wildcards.region}" '
BEGIN {{
    map["a"] = "m6A"
    map["m"] = "m5C"
    map["17596"] = "Am"
    map["17802"] = "pseU"
    map["19227"] = "Um"
    map["19228"] = "Cm"
    map["69426"] = "inosine"
}}
NR > 1 && $12 in map {{
    outfile = outdir "/" sample "_readmods_NoContext_" region "_" map[$12] ".tsv"
    print >> outfile
}}
' {input.tsv}
        """)

rule call_split_bedmethyl:
    input:
        expand("lrna/intermediates/{sample}/methylation/bymod/{sample}_{mod_name}_bedMethyl.bed", sample=samples, mod_name=MOD_NAMES)

rule call_split_extractmods:
