rule dorado:
    input:
        aref = "aref.done.outfile",
        cont= dorado_container
    params:
        input_dir = lambda wildcards: sample_table.loc[sample_table["sample_name"] == wildcards.sample, "nanopore_rawdata_dir"].iloc[0],
        reference = lambda wildcards: "aref/default/%s.fa"%(wildcards.sample) if config["lrna"]["per_sample_ref"] == "yes" else "aref/default/A.REF.fa"
    output:
        "lrna/intermediates/{sample}/alignments/{rate}/{sample}.{type}.{modification_string}.bam"
    benchmark:
        "lrna/benchmarks/dorado/{rate}.{sample}.{type}.{modification_string}.tsv"
    wildcard_constraints:
        sample="[0-9A-Za-z_]+",
        type = "[0-9A-Za-z]+",
        rate = "nanopore",
        modification_string = "[0-9A-Za-z_-]+"
    container:
        dorado_container
    resources:
        cpus_per_task =10,
        slurm_partition="gpu-he",
        mem_mb = 220000,
        runtime = 5560,
        slurm_extra="'--gres=gpu:nvidia_rtx_a6000:2'"
    shell:
        """
mkdir -p $(dirname {output}) 
if [[ {wildcards.modification_string} == "unmod" ]]; then
    dorado \
    basecaller \
    {wildcards.type} \
    {params.input_dir} \
    --recursive \
    --verbose \
    --estimate-poly-a \
    --reference {params.reference} \
    --mm2-opts "-x splice -k 14" > {output}
else
    mod_string=$(echo {wildcards.modification_string} | tr "-" ",")
    dorado \
    basecaller \
    {wildcards.type},$mod_string \
    {params.input_dir} \
    --recursive \
    --verbose \
    --estimate-poly-a \
    --reference {params.reference} \
    --mm2-opts "-x splice -k 14" > {output}
fi
        """

rule get_dorado_alignments:
    input:
        [
            "lrna/intermediates/%s/alignments/%s/%s.%s.%s.sorted.bam" % (
                s,
                sample_table.loc[sample_table.sample_name == s, "rate"].iloc[0],
                s,
                sample_table.loc[sample_table.sample_name == s, "type"].iloc[0],
                sample_table.loc[sample_table.sample_name == s, "modification_string"].iloc[0]
            )
            for s in sample_table.loc[sample_table.platform == "nanopore", "sample_name"].tolist()
        ]


rule getunmapped_reads:
    input:
        sortedbam = lambda w: "lrna/intermediates/%s/alignments/%s/%s.%s.%s.sorted.bam" % (
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "rate"].iloc[0],
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "type"].iloc[0],
            sample_table.loc[sample_table.sample_name == w.sample, "modification_string"].iloc[0]
        )
    output: 
        reads = expand("lrna/intermediates/{{sample}}/fastqs/{rate}/{{sample}}.unmapped.fq.gz", rate = config["lrna"]["rate"])
    wildcard_constraints:
        sample="[0-9A-Za-z_]+",
        type = "[0-9A-Za-z]+",
        rate = "[0-9A-Za-z]+",
        modification_string = "[0-9A-Za-z_-]+"
    resources:
        cpus_per_task =8,
        runtime = 100,
        mem_mb = 50000
    conda: "omics"
    shell:
        """
samtools view -f 4 -b {input.sortedbam} | samtools fastq -@ 8 - | gzip > {output.reads}
        """

