rule deseq:
    input:
        counts = "lrna/outs/agg/featurecounts_genes/counts.txt",
        rte_counts = expand("lrna/outs/{sample}/telescope/telescope-run_stats.tsv", sample = samples),
        alignment_stats = [
            "lrna/qc/%s/%s/%s.%s.%s.sorted.bam.stats.txt" % (
                s,
                sample_table.loc[sample_table.sample_name == s, "rate"].iloc[0],
                s,
                sample_table.loc[sample_table.sample_name == s, "type"].iloc[0],
                sample_table.loc[sample_table.sample_name == s, "modification_string"].iloc[0]
            )
            for s in samples
        ] if config["lrna"]["normalization_method"] == "library_size" else [],
    params:
        sample_table = config["lrna"]["sample_table"],
        contrasts = config["lrna"]["contrasts"],
        levels = config["lrna"]["levels"],
        paralellize_bioc = config["lrna"]["paralellize_bioc"],
        normalization_method = config["lrna"]["normalization_method"],
        counttype = lambda w: w.counttype,
        outputdir =lambda w, output: os.path.dirname(os.path.dirname(output.counts_normed)),
    resources:
        cpus_per_task =10,
        mem_mb = 200000,
        runtime = 1000
    conda: "deseq"
    wildcard_constraints:
        counttype="[A-Za-z0-9_]+"
    output:
        results_genes = expand("lrna/results/agg/deseq/{{counttype}}/{contrast}/results_genes.csv", contrast = config["lrna"]["contrasts"]),
        results_rtes = expand("lrna/results/agg/deseq/{{counttype}}/{contrast}/results_rtes.csv", contrast = config["lrna"]["contrasts"]),
        counts_normed = "lrna/results/agg/deseq/{counttype}/counttablesizenormed.csv",
        sizefactors = "lrna/results/agg/deseq/{counttype}/sizefactors.csv",
        environment = "lrna/results/agg/deseq/{counttype}/deseq_environment.RData",
    benchmark:
        "lrna/benchmarks/deseq/{counttype}.tsv"
    script:
        "scripts/deseq.R"

