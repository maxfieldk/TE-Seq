rule dorado_seqsummary:
    input:
        sortedbam = lambda w: "lrna/intermediates/%s/alignments/%s/%s.%s.%s.sorted.bam" % (
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "rate"].iloc[0],
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "type"].iloc[0],
            sample_table.loc[sample_table.sample_name == w.sample, "modification_string"].iloc[0]
        ),
        sortedbambai = lambda w: "lrna/intermediates/%s/alignments/%s/%s.%s.%s.sorted.bam.bai" % (
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "rate"].iloc[0],
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "type"].iloc[0],
            sample_table.loc[sample_table.sample_name == w.sample, "modification_string"].iloc[0]
        )
    params:
        dorado = config["lrna"]["dorado"]
    output:
        "lrna/qc/{sample}/{sample}.doradosummary.txt"
    benchmark:
        "lrna/benchmarks/dorado_seqsummary/{sample}.tsv"
    conda:
        "omics"
    shell:
        """
{params.dorado} summary {input.sortedbam} > {output}
        """

