rule bedmethylanalysis:
    input:
        bedmethylpaths = expand("lrna/intermediates/{sample}/methylation/bymod/{sample}_{{mod_name}}_bedMethyl.bed", sample = samples),
        read_mods = expand('lrna/intermediates/{sample}/methylation/bymod/{sample}_readmods_NoContext_{region}_{{mod_name}}.tsv', sample = samples, region = config["lrna"]["rte_subfamily_read_level_analysis"])
        # region_bedmethylpaths = expand("lrna/intermediates/{sample}/methylation/bymod/{sample}_{element}_{{mod_name}}_bedMethyl.bed", sample = samples, element = list(set(config["lrna"]["rte_subfamily_read_level_analysis"] + config["lrna"]["rte_subfamily_extra_modification_analysis"])))
    output:
        grsdf = "lrna/Rintermediates/{mod_name}/grsdf.tsv"
    params:
        mod_name = lambda w: w.mod_name,
        mod_code = lambda w: [k for k, v in MOD_CODE_TO_NAME.items() if v == w.mod_name][0],
        regions = list(set(config["lrna"]["rte_subfamily_read_level_analysis"] + config["lrna"]["rte_subfamily_extra_modification_analysis"]))
    resources:
        cpus_per_task = 10,
        mem_mb = 400000,
        runtime = 500
    conda:
        "ds"
    script:
        "scripts/bedmethylanalysis_process_new.R"

rule call_bedmethylanalysis:
    input:
        expand("lrna/Rintermediates/{mod_name}/grsdf.tsv", mod_name = MOD_NAMES)

#RULE OVERRIDES
def maybe_include_rule_override(module_name):
    path = config.get(module_name, {}).get("rule_override", None)
    if path and str(path).strip():  # skip if path is None, "", or just whitespace
        path = str(path).strip()
        if not Path(path).exists():
            raise ValueError(f"Override rule file not found for {module_name}: {path}")
        include: path
        print(f"CAUTION USING {module_name} RULE OVERRIDES - CHECK conf/config.yaml {module_name} rule_overrides")
        
maybe_include_rule_override("lrna")