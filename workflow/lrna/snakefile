rule extract_fastq_for_telescope:
    input:
        sortedbam = lambda w: "lrna/intermediates/%s/alignments/%s/%s.%s.%s.sorted.bam" % (
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "rate"].iloc[0],
            w.sample,
            sample_table.loc[sample_table.sample_name == w.sample, "type"].iloc[0],
            sample_table.loc[sample_table.sample_name == w.sample, "modification_string"].iloc[0]
        )
    output:
        fastq = temp("lrna/intermediates/{sample}/fastqs/{sample}.telescope.fq.gz")
    conda:
        "omics"
    benchmark:
        "lrna/benchmarks/extract_fastq_for_telescope/{sample}.tsv"
    resources:
        cpus_per_task = 4,
        mem_mb = 64000,
        runtime = 120
    shell:
        """
mkdir -p $(dirname {output.fastq})
samtools fastq {input.sortedbam} | gzip > {output.fastq}
        """

rule minimap2_multimapping:
    input:
        fastq = "lrna/intermediates/{sample}/fastqs/{sample}.telescope.fq.gz"
    params:
        reference = lambda wildcards: "aref/default/%s.fa"%(wildcards.sample) if config["lrna"]["per_sample_ref"] == "yes" else "aref/default/A.REF.fa",
        mm2_preset = lambda w: "splice" if sample_table.loc[sample_table.sample_name == w.sample, "platform"].iloc[0] == "nanopore" else "splice:hq"
    output:
        bam = "lrna/intermediates/{sample}/alignments/{sample}.multimapped.sorted.bam",
        bai = "lrna/intermediates/{sample}/alignments/{sample}.multimapped.sorted.bam.bai"
    container: None
    conda:
        "minimap2"
    benchmark:
        "lrna/benchmarks/minimap2_multimapping/{sample}.tsv"
    resources:
        cpus_per_task = 20,
        runtime = 900,
        mem_mb = 80000
    shell:
        """
minimap2 -ax {params.mm2_preset} --secondary=yes -N 100 -t 16 {params.reference} {input.fastq} | \
samtools sort -@4 -m2g -T {wildcards.sample} -O bam -o {output.bam}
samtools index -@8 {output.bam}
        """

rule collateBam:
    input:
        bam = "lrna/intermediates/{sample}/alignments/{sample}.multimapped.sorted.bam"
    output:
        collatedbam = temp("lrna/intermediates/{sample}/alignments/{sample}.collated.bam")
    conda:
        "omics"
    benchmark:
        "lrna/benchmarks/collateBam/{sample}.tsv"
    resources:
        mem_mb = 128000,
        runtime = 120
    shell:
        """
samtools collate -o {output.collatedbam} {input.bam}
        """

rule telescope:
    input:
        collatedbam = "lrna/intermediates/{sample}/alignments/{sample}.collated.bam",
        libtype = "lrna/qc/library_type.txt",
    params:
        strandparam = lambda wildcards: getTelescopeStrandParam(),
        gff = lambda wildcards: "aref/default/%s_annotations/%s_repeatmasker.gff2"%(wildcards.sample, wildcards.sample) if config["lrna"]["per_sample_ref"] == "yes" else "aref/default/A.REF_annotations/A.REF_repeatmasker.gff2"
    retries: 3
    output:
        counts = "lrna/outs/{sample}/telescope/telescope-run_stats.tsv",
        bam = "lrna/outs/{sample}/telescope/telescope-updated.bam"
    benchmark:
        "lrna/benchmarks/telescope/{sample}.tsv"
    threads: 4
    conda:
        "telescope3"
    resources:
        mem_mb = 128000,
        runtime = 600
    shell:
        """
echo {params.strandparam}
mkdir -p $(dirname {output.counts})

if [ "{params.strandparam}" = None ]; then
echo "removing L1 antisense transcripts"
awk -v FS='\t' -v OFS='\t' '$0 ~ /^#/ || $9 !~ /__AS"/' {params.gff} > {output.counts}.temp.gff2

telescope assign \
--attribute gene_id \
--ncpu 1 \
--updated_sam \
--stranded_mode {params.strandparam} \
--reassign_mode average \
--outdir $(dirname {output.counts}) \
{input.collatedbam} \
{output.counts}.temp.gff2

rm {output.counts}.temp.gff2

else

telescope assign \
--attribute gene_id \
--ncpu 1 \
--updated_sam \
--stranded_mode {params.strandparam} \
--reassign_mode average \
--outdir $(dirname {output.counts}) \
{input.collatedbam} \
{params.gff}

fi
        """

rule sortIndexTelescopeBam:
    input:
        bam = "lrna/outs/{sample}/telescope/telescope-updated.bam"
